# =============================================================================
# Messenger - environment variables
# Copy this file to .env and adjust values
# =============================================================================

# ---------- General ----------
PROJECT_NAME=messenger
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=messenger
POSTGRES_PASSWORD=messenger_pass_change_me
POSTGRES_DB=messenger

# ---------- MongoDB ----------
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_USER=messenger
MONGO_PASSWORD=messenger_pass_change_me
MONGO_DB=messenger_messages

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- JWT ----------
# Generate with: openssl rand -hex 64
JWT_SECRET_KEY=change_me_to_a_long_random_string_at_least_64_chars_long_please
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# ---------- LiveKit ----------
# IMPORTANT: LIVEKIT_API_SECRET must be at least 32 characters long.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_me_at_least_32_chars_long
LIVEKIT_HOST=livekit
LIVEKIT_PORT=7880
LIVEKIT_URL=ws://localhost:7880

# ---------- Service URLs (internal) ----------
AUTH_SERVICE_URL=http://auth-service:8000
USER_SERVICE_URL=http://user-service:8000
CHANNEL_SERVICE_URL=http://channel-service:8000
MESSAGE_SERVICE_URL=http://message-service:8000
GATEWAY_SERVICE_URL=http://gateway-service:8000
MEDIA_SERVICE_URL=http://media-service:8000

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost/api
VITE_WS_URL=ws://localhost/ws
VITE_LIVEKIT_URL=ws://localhost:7880

# ---------- CORS ----------
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:3000
